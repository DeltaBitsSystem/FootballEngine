<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <Content Include="../FootballEngine.Client/Assets/MatchViewer/PlayerMotionRework/corrective-golden.json" Link="corrective-golden.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="../FootballEngine.Client/Assets/MatchViewer/StadiumKit/layout-golden.json" Link="layout-golden.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="../FootballEngine.Client/Assets/MatchViewer/StadiumKit/kit.json" Link="kit.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="../FootballEngine.Client/Match3D/Shaders/CameraUniform.wgsl" Link="Match3D/Shaders/CameraUniform.wgsl" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="RoutingTests.fs" />
    <Compile Include="NewsPageTests.fs" />
    <Compile Include="JobsPageTests.fs" />
    <Compile Include="ViewerQualityTests.fs" />
    <Compile Include="PersistenceTests.fs" />
    <Compile Include="TacticsDraftTests.fs" />
    <Compile Include="ModEditorTests.fs" />
    <Compile Include="LiveMatchTests.fs" />
    <Compile Include="CharacterAnimationTests.fs" />
    <Compile Include="Animation\MotionRuntimeTests.fs" />
    <Compile Include="Animation\MotionTimelineTests.fs" />
    <Compile Include="HdrLightingTests.fs" />
    <Compile Include="ViewerPresentationTests.fs" />
    <Compile Include="PitchMarkingsTests.fs" />
    <Compile Include="MatchDiagnosticsTests.fs" />
    <Compile Include="MatchHudTests.fs" />
    <Compile Include="PresentationLoopTests.fs" />
    <Compile Include="RenderWorkerTests.fs" />
    <Compile Include="StadiumLayoutTests.fs" />
    <Compile Include="Match3DFoundationTests.fs" />
    <Compile Include="Match3DSceneTests.fs" />
    <Compile Include="Match3DFrameTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FootballEngine.Client\FootballEngine.Client.fsproj" />
    <ProjectReference Include="..\FootballEngine.Core\FootballEngine.Core.fsproj" />
    <ProjectReference Include="..\Tools\MatchDiagnostics\MatchDiagnostics.fsproj" />
    <PackageReference Include="Expecto" />
    <PackageReference Include="sqlite-net-pcl" />
  </ItemGroup>
</Project>
