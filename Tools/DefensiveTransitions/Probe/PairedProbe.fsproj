<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>DefensiveTransitionProbe</AssemblyName>
    <ProbeDirectory Condition="'$(ProbeDirectory)' == ''">$(MSBuildThisFileDirectory)../bin/Release/net10.0</ProbeDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="FootballEngine.Core">
      <HintPath>$(ProbeDirectory)/FootballEngine.Core.dll</HintPath>
    </Reference>
    <Reference Include="DefensiveTransitions">
      <HintPath>$(ProbeDirectory)/DefensiveTransitions.dll</HintPath>
    </Reference>
    <Compile Include="../PairedProbe.fs" />
  </ItemGroup>
</Project>
