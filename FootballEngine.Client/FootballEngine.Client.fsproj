<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <OtherFlags>--warnon:1182</OtherFlags>
    </PropertyGroup>

    <ItemGroup>

        <Compile Include="Database\JsonCodec.fs"/>
        <Compile Include="Database\SnapshotRepository.fs"/>
        <Compile Include="Settings\SettingsStorage.fs"/>
        <Compile Include="AppState\Icons.fs"/>
        <Compile Include="Routing\Route.fs"/>
        <Compile Include="AppState\ModEditorTypes.fs"/>
        <Compile Include="AppState\Types.fs"/>
        <Compile Include="AppState\Msg.fs"/>
        <Compile Include="AppState\MatchPresentation.fs"/>
        <Compile Include="AppState\MatchRuntime.fs"/>
        <Compile Include="AppState\ModEditorPackage.fs"/>
        <Compile Include="Shots\Shots.fs"/>
        <Compile Include="Views\Shared\Localization.fs"/>
        <Compile Include="Views\Theme.fs"/>
        <Compile Include="Views\Shared\Formatters.fs"/>
        <Compile Include="AppState\Projections.fs"/>
        <Compile Include="Views\Shared\PlayerPresenter.fs"/>
        <Compile Include="Views\Shared\ColumnDefs.fs"/>
        <Compile Include="Views\Shared\SelectionStyle.fs"/>
        <Compile Include="AppState\Slices\SquadSlice.fs"/>
        <Compile Include="AppState\Slices\TacticsSlice.fs"/>
        <Compile Include="AppState\Slices\TrainingSlice.fs"/>
        <Compile Include="AppState\Slices\FinanceSlice.fs"/>
        <Compile Include="AppState\Slices\InboxSlice.fs"/>
        <Compile Include="AppState\Slices\CalendarSlice.fs"/>
        <Compile Include="AppState\Slices\MatchSlice.fs"/>
        <Compile Include="AppState\Slices\ScoutingSlice.fs"/>
        <Compile Include="AppState\Slices\SettingsSlice.fs"/>
        <Compile Include="AppState\UpdateSetup.fs"/>
        <Compile Include="AppState\UpdateSim.fs"/>
        <Compile Include="AppState\UpdateTransfer.fs"/>
        <Compile Include="AppState\UpdateModEditor.fs"/>
        <Compile Include="AppState\AppState.fs"/>
        <Compile Include="Views\Components\UI.fs"/>
        <Compile Include="Views\Components\Sidebar.fs"/>
        <Compile Include="Views\Components\Header.fs"/>
        <Compile Include="Views\Components\FootballPitch.fs"/>
        <Compile Include="Views\Components\MatchVisualTypes.fs"/>
        <Compile Include="Views\Components\MatchCamera.fs"/>
        <Compile Include="Views\Components\MatchProjection.fs"/>
        <Compile Include="Match3D\StadiumAsset.fs"/>
        <Compile Include="Match3D\WebGpuStadiumRenderer.fs"/>
        <Compile Include="Views\MatchPitch\RenderResources.fs"/>
        <Compile Include="Views\MatchPitch\PitchRenderer.fs"/>
        <Compile Include="Views\MatchPitch\EntityRenderer.fs"/>
        <Compile Include="Views\MatchPitch\MatchPitchControl.fs"/>
        <Compile Include="Views\Components\EventTimeline.fs"/>
        <Compile Include="Views\Components\StatsPanel.fs"/>
        <Compile Include="Views\Components\CommentaryOverlay.fs"/>
        <Compile Include="Views\Components\MatchViewer.fs"/>
        <Compile Include="Views\Pages\Loading.fs"/>
        <Compile Include="Views\Pages\Setup.fs"/>
        <Compile Include="Views\Pages\Home.fs"/>
        <Compile Include="Views\Pages\Calendar.fs"/>
        <Compile Include="Views\Pages\Inbox.fs"/>
        <Compile Include="Views\Pages\Squad.fs"/>
        <Compile Include="Views\Pages\Tactic.fs"/>
        <Compile Include="Views\Pages\Training.fs"/>
        <Compile Include="Views\Pages\Finances.fs"/>
        <Compile Include="Views\Pages\Scouting.fs"/>
        <Compile Include="Views\Pages\Transfer.fs"/>
        <Compile Include="Views\Pages\ModEditor.fs"/>
        <Compile Include="Views\Pages\Settings.fs"/>
        <Compile Include="Program.fs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FootballEngine.Core\FootballEngine.Core.fsproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\Data\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>Data\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </Content>
        <Content Include="Assets\MatchViewer\stadium.glb">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop"/>
        <PackageReference Include="Avalonia.FuncUI"/>
        <PackageReference Include="Avalonia.FuncUI.Elmish"/>
        <PackageReference Include="Avalonia.Skia"/>
        <PackageReference Include="Avalonia.Themes.Fluent"/>
        <PackageReference Include="Elmish"/>
        <PackageReference Include="FsToolkit.ErrorHandling"/>
        <PackageReference Include="Material.Icons.Avalonia"/>
        <PackageReference Include="SharpGLTF.Core"/>
        <PackageReference Include="Silk.NET.WebGPU"/>
        <PackageReference Include="Silk.NET.WebGPU.Native.WGPU"/>
        <PackageReference Include="sqlite-net-pcl"/>
        <PackageReference Include="FSharp.SystemTextJson"/>
    </ItemGroup>

</Project>
