root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{fs,fsx,fsscript}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{fsproj,fsx}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json,md}]
indent_style = space
indent_size = 2

[*.slnx]
indent_style = space
indent_size = 2

[*.{sh,bash}]
indent_style = space
indent_size = 2

[*.{ps1,psm1}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[scripts/test.fsx]
indent_size = 4

[scripts/testing/*.fsx]
indent_size = 4
