<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Matches run in parallel; one heap per core keeps them from serialising on collections. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Types.fs"/>
    <Compile Include="Metrics.fs"/>
    <Compile Include="ErrorCalculator.fs"/>
    <Compile Include="SimulatorRunner.fs"/>
    <Compile Include="AutoTuner.fs"/>
    <Compile Include="Validator.fs"/>
    <Compile Include="Overrides.fs"/>
    <Compile Include="Report.fs"/>
    <Compile Include="QuickFit.fs"/>
    <Compile Include="Program.fs"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FootballEngine.Core/FootballEngine.Core.fsproj"/>
    <ProjectReference Include="../FootballEngine.Core.Tests/FootballEngine.Core.Tests.fsproj"/>
  </ItemGroup>
</Project>
