# ============================================================
# FootballEngine — WHITELIST POLICY
#
# Git ignora TODO por defecto. Solo se trackea lo que aparece
# explícitamente abajo (deny-all + allowlist). Para agregar algo
# nuevo: escribir el patrón aquí, no confiar en el default.
#
# No existen blacklists de bin/obj/tmp: están excluidos por
# naturaleza porque nunca están en el allowlist.
# ============================================================

# --- Ignorar todo por defecto ---
*

# --- Pero permitir descender en directorios (sino las negaciones no matchean) ---
!*/

# ============================================================
# ALLOWLIST — lo que se trackea
# ============================================================

# --- Infra del repo ---
!.gitignore
!.editorconfig
!.fantomasignore
!.codex
!dotnet-tools.json
!fantomas-config.json
!global.json
!opencode.json
!FootballEngine.slnx
!/Directory.Build.props
!/Directory.Build.targets
!/Directory.Packages.props

# --- F# fuente (extensión whitelist — nunca es output generado) ---
!**/*.fs
!**/*.fsx
!**/*.fsproj
!**/*.fsi

# --- Soluciones / build del repo ---
!**/*.slnx

# --- Datos del juego (JSON de contenido, no config de build) ---
!/Data/**
!weights.json
!weights_trained.json

# --- Documentación (raíz y docs/) ---
!/*.md
!/docs/**

# --- CI/CD y scripts ---
!/.github/**
!/scripts/**
!/*.sh
!/*.ps1
!/*.yml
!build.sh
!build.ps1
!publish.sh

# --- Benchmarks y herramientas ---
!/FootballEngine.Benchmarks/**
!/FootballEngine.Tests/**
!/Tools/**
!/Training/**
!bench.fsx
!validate_matches.fsx
!test_shot.fsx

# --- Packaging y screenshots (assets estáticos) ---
!/packaging/**
!/screenshots/**
!/FootballEngine.Client/Assets/MatchViewer/*.py
!/FootballEngine.Client/Assets/MatchViewer/player-*.png
!/FootballEngine.Client/Assets/MatchViewer/players.blend
!/FootballEngine.Client/Assets/MatchViewer/player.glb
!/FootballEngine.Client/Assets/MatchViewer/player-hair.glb
!/FootballEngine.Client/Assets/MatchViewer/player-hair.json
!/FootballEngine.Client/Assets/MatchViewer/player-motion.json
!/FootballEngine.Client/Assets/MatchViewer/Sources/MakeHuman/base.obj
!/FootballEngine.Client/Assets/MatchViewer/Sources/MakeHuman/*.target
!/FootballEngine.Client/Assets/MatchViewer/Sources/MakeHuman/*.json
!/FootballEngine.Client/Assets/MatchViewer/Sources/MakeHuman/*.md
!/FootballEngine.Client/Assets/MatchViewer/pitch-floodlit.blend
!/FootballEngine.Client/Assets/MatchViewer/stadium.glb
!/FootballEngine.Client/Assets/MatchViewer/stadium.environment.json
# UI fonts (SIL OFL; licence travels with the files)
!/FootballEngine.Client/Assets/Fonts/*.ttf
!/FootballEngine.Client/Assets/Fonts/OFL-*.txt
!/FootballEngine.Client/Assets/MatchViewer/OriginalSky/*.exr
# Original kit/crowd/ball packs: generated by Tools/MatchViewer3D, sources and provenance travel with them
!/FootballEngine.Client/Assets/MatchViewer/StadiumKit/**
!/FootballEngine.Client/Assets/MatchViewer/Crowd/**
!/FootballEngine.Client/Assets/MatchViewer/Ball/**
!/FootballEngine.Client/Assets/MatchViewer/Kits/**
!/FootballEngine.Client/Assets/MatchViewer/manifest.json
!/FootballEngine.Client/Assets/MatchViewer/LICENSES.md
!/FootballEngine.Client/Assets/MatchViewer/Surfaces/*.bin
!/FootballEngine.Client/Assets/MatchViewer/Surfaces/manifest.json
!/FootballEngine.Client/Assets/MatchViewer/Surfaces/README.md
!/FootballEngine.Client/Assets/MatchViewer/Lighting/*.bin
!/FootballEngine.Client/Assets/MatchViewer/Lighting/manifest.json
!/FootballEngine.Client/Assets/MatchViewer/Lighting/README.md
!/FootballEngine.Client/Assets/MatchViewer/PlayerMotionRework/corrective-golden.json
!/FootballEngine.Client/Match3D/Shaders/*.wgsl

# --- Planes de agencia (opencode) ---
!/.opencode/**

# --- Mods / Data generada ---

# ============================================================
# DENYLIST — dirs generados DENTRO de árboles whitelisted
# (siempre van DESPUÉS del allowlist; "el último patrón gana")
# ============================================================

**/bin/
**/obj/
**/BenchmarkDotNet.Artifacts/
.idea/
.vs/
diag/
trace.nettrace
trace.nettrace.etlx

# ============================================================
# ESCRITA MANUAL: si un archivo nuevo no aparece arriba, no se
# sube con `git add -A`. Agregá el patrón al allowlist primero.
# ============================================================

# --- Intermediate render passes of authoring tools (rebuilt by the scripts) ---
/Tools/MatchViewer3D/Surfaces/_passes/

# --- Python bytecode generated by authoring tools ---
__pycache__/
